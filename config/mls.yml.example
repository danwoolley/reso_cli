# Example reso_cli MLS config. Your real config lives OUTSIDE this repo:
#   ~/.config/reso_cli/mls.yml   (or the path in $RESO_CLI_CONFIG)
#
# You normally never edit it by hand: /mls-setup in Claude Code, or
# `./reso_cli add`, creates and updates it. This file only documents the format.

# The MLS that reso_cli talks to (must match a name under `mls:`)
active: Example OAuth MLS

mls:
  # OAuth2 client credentials
  Example OAuth MLS:
    endpoint: https://api.your-mls.com/odata        # OData service root
    authentication:
      endpoint: https://auth.your-mls.com/oauth2/token
      client_id: YOUR_CLIENT_ID
      client_secret: YOUR_CLIENT_SECRET
      scope: ''                                     # most servers want none
    # Optional: default localization per resource, if your MLS requires one
    # localizations:
    #   Property: Residential
    # Optional: use the /replication endpoint for large queries
    # use_replication_endpoint: false

  # Static bearer token
  Example Bearer MLS:
    endpoint: https://api.other-mls.com/odata
    authentication:
      access_token: YOUR_BEARER_TOKEN
      token_type: Bearer
